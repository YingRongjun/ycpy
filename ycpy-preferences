#!/bin/sh
# ycpy 首选项对话框启动器。
# 和 ycpy-engine 一样由安装脚本生成绝对路径，因此可以被 .desktop 直接调用。

set -e

self="$0"
case "$self" in
    */*) ;;
    *) self="$(command -v "$self")" ;;
esac
here="$(cd "$(dirname "$self")" && pwd)"

if [ -n "${PYTHONPATH:-}" ]; then
    PYTHONPATH="$here:$PYTHONPATH"
else
    PYTHONPATH="$here"
fi
export PYTHONPATH

for candidate in "${PYIM_PYTHON:-}" /usr/bin/python3 python3; do
    [ -n "$candidate" ] || continue
    if "$candidate" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
        exec "$candidate" -B -m ycpy.preferences "$@"
    fi
done

echo "ycpy: 找不到可用的 python3（需要 3.9+）" >&2
exit 1